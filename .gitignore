# Secrets and personal files: each person generates their own.
# keys/ is the demo login signing key (python setup_demo.py).
# .mcp.json is the Claude Code config with a login token (python connect_claude.py).
keys/
.mcp.json
.env
.env.*

# Generated by the scripts: never commit.
# config/ and repos/ come from python setup_demo.py (repos/ holds nested git repositories).
# cache/ comes from python run_gateway.py (skills fetched from GitHub).
config/
repos/
cache/
*.log
check.out

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
